{
  "name": "tiktok-auto-gen",
  "version": "1.0.0",
  "description": "Batch Video Factory",
  "main": "server.js",
  "scripts": {
    "dev": "remotion studio",
    "factory": "node server.js",
    "render": "node generate-audio.js && npx remotion render src/index.ts 1 --force --concurrency=1",
    "package": "zip -r ../video-generator.zip . -x '.git/*' -x 'renders/*' -x 'recordings/*' -x 'out/*' -x 'UserConfig.json' -x '.server.pid' -x '.DS_Store' -x '*/.DS_Store' -x 'public/voiceovers/*' -x 'public/voice-previews/*'",
    "package:lite": "zip -r ../video-generator-lite.zip . -x '.git/*' -x 'node_modules/*' -x 'renders/*' -x 'recordings/*' -x 'out/*' -x 'UserConfig.json' -x '.server.pid' -x '.DS_Store' -x '*/.DS_Store' -x 'public/voiceovers/*' -x 'public/voice-previews/*'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@remotion/bundler": "4.0.434",
    "@remotion/cli": "4.0.434",
    "@remotion/media": "4.0.434",
    "@remotion/renderer": "4.0.434",
    "@remotion/studio": "4.0.434",
    "@remotion/tailwind-v4": "4.0.434",
    "axios": "^1.13.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "gtts": "^0.2.1",
    "mp3-duration": "^1.1.0",
    "multer": "^2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.434",
    "socket.io": "^4.7.2"
  }
}
